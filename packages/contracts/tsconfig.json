{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "mocha", "chai"]
  },
  "include": ["hardhat.config.ts", "scripts/**/*.ts", "test/**/*.ts", "types/ethers-contracts/**/*.ts"]
}
